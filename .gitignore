# ==============================================================================
# Git Ignore Rules — Arabic Academic Plagiarism Detector
# ==============================================================================

# Build & distribution outputs
dist/
build/
*.exe
*.spec

# Python runtime & test caches
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
*.egg-info/
.eggs/
.pytest_cache/
.pytest-*/
.coverage
htmlcov/
build_log.txt
tmp/
*.pdf

# Local databases & journal files (NEVER COMMIT)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
Database/
database/
*.benchmark.db*

# Operational logs & diagnostics (NEVER COMMIT)
logs/
Logs/
*.log
Diagnostics/
diagnostics/

# Content-Addressed Storage & document repositories (NEVER COMMIT)
Storage/
storage/
temp_uploads/
vendor/

# System backups (NEVER COMMIT)
Backups/
backups/

# Process PID & lock files & local runtime configs
Config/
config/
*.pid
*.lock
.secret_key

# Benchmark heavy generated datasets
benchmark/data/
scratch/

# Secrets, keys, and environment overrides (NEVER COMMIT)
.env
.env.*
!.env.example
secrets/
*.key
*.pem

# IDE & OS specific files
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini
sample_pdf_text.txt
